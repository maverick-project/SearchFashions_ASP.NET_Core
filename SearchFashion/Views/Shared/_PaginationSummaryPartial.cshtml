@model SearchFashion.Common.IPaginatedList

@{
    // ページネーションのサマリー表示の部分ビュー
}

@if (Model != null && Model.TotalPages > 0)
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="text-muted">
            全 <span class="fw-bold text-dark">@Model.TotalCount</span> 件中
            <span class="fw-bold text-dark">@Model.StartIndex</span> 〜
            <span class="fw-bold text-dark">@Model.EndIndex</span> 件目を表示
        </div>
    </div>
}
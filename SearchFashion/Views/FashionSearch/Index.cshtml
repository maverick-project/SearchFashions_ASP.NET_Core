@model FashionSearch.ViewModels.FashionSearchViewModel

@{
    ViewData["Title"] = "ファッションアイテム検索";
}

<script type="text/javascript">
document.addEventListener('DOMContentLoaded', function () {
    const articleTypeInput = document.getElementById('ArticleType');
    const articleTypeList = document.getElementById('ArticleTypeList');

    // 商品区分の入力イベント（文字が変更されるたびに発火）
    articleTypeInput.addEventListener('input', async function () {
        const query = this.value.trim();

        // 入力が空の場合は候補を隠して終了
        if (query.length === 0) {
            articleTypeList.style.display = 'none';
            articleTypeList.innerHTML = '';
            return;
        }

        try {
            // コントローラーへ非同期リクエスト
            const response = await fetch(`/FashionSearch/SearchArticleTypes?query=${encodeURIComponent(query)}`);
            if (!response.ok) return;

            const articleTypes = await response.json();
            articleTypeList.innerHTML = '';

            if (articleTypes.length > 0) {
                // 候補リストを生成して追加
                articleTypes.forEach(articleType => {
                    const li = document.createElement('li');
                    li.className = 'list-group-item list-group-item-action';
                    li.textContent = articleType;
                    li.style.cursor = 'pointer';

                    // 候補をクリックしたときの処理
                    li.addEventListener('click', function () {
                        articleTypeInput.value = articleType; // テキストボックスに反映
                        articleTypeList.style.display = 'none'; // リストを閉じる
                    });

                    articleTypeList.appendChild(li);
                });
                articleTypeList.style.display = 'block'; // リストを表示
            } else {
                articleTypeList.style.display = 'none';
            }
        } catch (error) {
            console.error('検索中にエラーが発生しました:', error);
        }
    });

    // テキストボックスや候補リスト以外をクリックしたらリストを閉じる
    document.addEventListener('click', function (e) {
        if (!articleTypeInput.contains(e.target) && !articleTypeList.contains(e.target)) {
            articleTypeList.style.display = 'none';
        }
    });

    // モーダルのDOM要素を取得
    const imageModalEl = document.getElementById('imageModal');
    // Bootstrap 5 のモーダルオブジェクトを生成
    const imageModal = new bootstrap.Modal(imageModalEl);

    const modalImage = document.getElementById('modalImage');
    const modalTitle = document.getElementById('imageModalLabel');

    // 「画像表示」ボタンがクリックされたときのイベントを監視（イベント委譲）
    document.addEventListener('click', function (e) {
        if (e.target && e.target.classList.contains('show-image-btn')) {
            const button = e.target;

            // 隠しパラメータ（data-* 属性）から値を取得
            const imagePath = button.getAttribute('data-image-path');
            const itemName = button.getAttribute('data-item-name');

            // モーダルのタイトルと画像の src を書き換える
            modalTitle.textContent = itemName ? `${itemName} の画像` : 'ファッション画像';
            modalImage.src = imagePath;
            // モーダルを表示する
            imageModal.show();
        }
    });

    // モーダルが閉じたときに画像をクリアしておく（メモリやチラ見え防止）
    imageModalEl.addEventListener('hidden.bs.modal', function () {
        modalImage.src = '';
    });
});
</script>
<div class="container my-4">
    <!-- 検索フォーム（カードデザイン） -->
    <div class="card shadow-sm border-0 mb-5">
        <div class="card-body bg-light rounded-3 p-4">
            <!-- 複合バリデーションエラーや全体のエラーをここにまとめて表示 -->
            <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

            <!-- ページネーション使うときはlinkがそのまま使えるのでpostではなくgetのほうがよい-->
            <form asp-action="Search" method="get">

                <!-- 現在のページ番号を保持・送信するための隠しフィールド -->
                <input type="hidden" asp-for="PageIndex" />

                <div class="row g-3">
                    <!-- 性別 -->
                    <div class="col-md-4">
                        <label asp-for="Gender" class="form-label fw-semibold text-secondary">@Html.DisplayNameFor(model => model.Gender)</label>
                        <select asp-for="Gender" asp-items="ViewBag.GenderList" class="form-select">
                            <option value="">指定なし</option>
                        </select>
                    </div>

                    <!-- カテゴリ -->
                    <div class="col-md-4">
                        <label asp-for="Category" class="form-label fw-semibold text-secondary">@Html.DisplayNameFor(model => model.Category)</label>
                        <select asp-for="Category" asp-items="ViewBag.CategoryList" class="form-select">
                            <option value="">指定なし</option>
                        </select>
                    </div>

                    <!-- 商品区分 -->
                    <div class="col-md-4">
                        <label asp-for="ArticleType" class="form-label fw-semibold text-secondary">@Html.DisplayNameFor(model => model.ArticleType)</label>
                        <!-- テキストボックス -->
                        <input asp-for="ArticleType" class="form-control" autocomplete="off" placeholder="商品区分を入力..." />
                        <!-- 検索候補リストを表示するエリア（初期は非表示） -->
                        <ul id="ArticleTypeList" class="list-group position-absolute w-100 shadow-sm" style="z-index: 1000; display: none; overflow-y: auto;">
                            <!-- JSで動的に <li> が追加されます -->
                        </ul>
                    </div>

                    <!-- 季節 -->
                    <div class="col-md-4">
                        <label asp-for="Season" class="form-label fw-semibold text-secondary">@Html.DisplayNameFor(model => model.Season)</label>
                        <select asp-for="Season" asp-items="ViewBag.SeasonList" class="form-select">
                            <option value="">指定なし</option>
                        </select>
                    </div>

                    <!-- 販売年(終了年) -->
                    <div class="col-md-2">
                        <label asp-for="EndYear" class="form-label fw-semibold text-secondary">@Html.DisplayNameFor(model => model.EndYear)　～</label>
                        <select asp-for="EndYear" asp-items="ViewBag.YearList" class="form-select">
                            <option value="">指定なし</option>
                        </select>
                    </div>
                    <!-- 販売年(開始年) -->
                    <div class="col-md-2">
                        <label asp-for="StartYear" class="form-label fw-semibold text-secondary">@Html.DisplayNameFor(model => model.StartYear)</label>
                        <select asp-for="StartYear" asp-items="ViewBag.YearList" class="form-select">
                            <option value="">指定なし</option>
                        </select>
                    </div>

                    <!-- 用途 -->
                    <div class="col-md-4">
                        <label asp-for="Usage" class="form-label fw-semibold text-secondary">@Html.DisplayNameFor(model => model.Usage)</label>
                        <select asp-for="Usage" asp-items="ViewBag.UsageList" class="form-select">
                            <option value="">指定なし</option>
                        </select>
                    </div>
                </div>

                <!-- ボタンエリア -->
                <div class="d-flex justify-content-end gap-2 mt-4">
                    <!-- クリア時は PageIndex を 1 にリセットできるように asp-route-PageIndex="1" をつけると親切です -->
                    <a asp-action="Index" asp-route-PageIndex="1" class="btn btn-outline-secondary px-4">クリア</a>

                    <button type="submit" class="btn btn-primary px-4 shadow-sm">
                        <i class="bi bi-search"></i> 検索する
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- 検索結果セクション -->
    @if (Model.Results != null && Model.Results.Any())
    {
        <!-- テーブルの上にページネーションのサマリー表示 -->
        <partial name="_PaginationSummaryPartial" model="Model.Results" />

        <div class="card shadow-sm border-0 mb-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.Gender)</th>
                            <th>@Html.DisplayNameFor(model => model.Category)</th>
                            <th>@Html.DisplayNameFor(model => model.ArticleType)</th>
                            <th>@Html.DisplayNameFor(model => model.Season)</th>
                            <th>販売年</th>
                            <th>@Html.DisplayNameFor(model => model.Usage)</th>
                            <th>@Html.DisplayNameFor(model => model.ImagePath)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Results)
                        {
                            <tr>
                                <td>@item.Gender</td>
                                <td>@item.Category</td>
                                <td>@item.Articletype</td>
                                <td>@item.Season</td>
                                <td>@item.Year</td>
                                <td>@item.Usage</td>
                                <!-- 画像ファイルパス -->
                                <td>
                                    <button type="button"
                                            class="btn btn-sm btn-link show-image-btn"
                                            data-image-path="@item.Imagepath"
                                            data-item-name="@(System.IO.Path.GetFileNameWithoutExtension(item.Imagepath))">
                                        表示
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>


        <!-- テーブルの下にページネーションUIを表示 -->
        <!-- Model.Results (PaginatedList<T>) をそのまま渡します -->
        <partial name="_PaginationPartial" model="Model.Results" />
    }
    else if (Model.Results != null && ViewBag.Initialized == false)
    {
        <!-- 検索されたが0件だった場合や、初期表示の状態 -->
        <div class="text-center py-5 text-muted">
            <div class="mb-2 fs-3">🔍</div>
            <p class="fs-5">条件に一致するアイテムがありません。または上のフォームから検索を行ってください。</p>
        </div>
    }
</div>

<!-- ========================================== -->
<!-- 画像表示用 Bootstrap 5 モーダル子画面 -->
<!-- ========================================== -->
<div class="modal fade" id="imageModal" tabindex="-1" aria-labelledby="imageModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="imageModalLabel">商品画像</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <!-- モーダル内に表示する画像タグ -->
                <img id="modalImage" src="" alt="商品画像" class="rounded w-50" style="max-height: 70vh;" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">閉じる</button>
            </div>
        </div>
    </div>
</div>